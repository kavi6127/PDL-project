// =====================================================
// JSON SENSOR DATA
// =====================================================

void handleData()
{

  String alertMessage =
    "NORMAL";


  if(
    tempAlert &&
    lowHRAlert
  )
  {

    alertMessage =
      "HIGH TEMPERATURE AND LOW HEART RATE";

  }

  else if(
    tempAlert &&
    highHRAlert
  )
  {

    alertMessage =
      "HIGH TEMPERATURE AND HIGH HEART RATE";

  }

  else if(
    tempAlert
  )
  {

    alertMessage =
      "HIGH TEMPERATURE";

  }

  else if(
    lowHRAlert
  )
  {

    alertMessage =
      "LOW HEART RATE";

  }

  else if(
    highHRAlert
  )
  {

    alertMessage =
      "HIGH HEART RATE";

  }


  bool anyAlert =
    tempAlert ||
    lowHRAlert ||
    highHRAlert;


  String json =
    "{";


  // Temperature

  json +=
    "\"temp\":";

  json +=
    String(
      temperatureC,
      1
    );


  json +=
    ",\"tempValid\":";

  json +=
    temperatureValid
    ?
    "true"
    :
    "false";


  // Heart rate

  json +=
    ",\"bpm\":";

  json +=
    String(
      displayBPM,
      1
    );


  json +=
    ",\"rawBpm\":";

  json +=
    String(
      currentBPM,
      1
    );


  json +=
    ",\"finger\":";

  json +=
    fingerDetected
    ?
    "true"
    :
    "false";


  // GPS

  json +=
    ",\"gpsFix\":";

  json +=
    gpsFix
    ?
    "true"
    :
    "false";


  json +=
    ",\"latitude\":";

  json +=
    String(
      gpsLatitude,
      6
    );


  json +=
    ",\"longitude\":";

  json +=
    String(
      gpsLongitude,
      6
    );


  json +=
    ",\"satellites\":";

  json +=
    String(
      gpsSatellites
    );


  json +=
    ",\"altitude\":";

  json +=
    String(
      gpsAltitude,
      1
    );


  // Alert

  json +=
    ",\"alert\":";

  json +=
    anyAlert
    ?
    "true"
    :
    "false";


  json +=
    ",\"message\":\"";

  json +=
    alertMessage;

  json +=
    "\"";


  json +=
    "}";


  server.sendHeader(
    "Cache-Control",
    "no-store"
  );


  server.send(
    200,
    "application/json",
    json
  );

}


// =====================================================
// SETUP
// =====================================================

void setup()
{

  Serial.begin(
    115200
  );


  delay(
    500
  );


  // ===================================================
  // I2C
  // ===================================================

  Wire.begin(
    21,
    22
  );


  // ===================================================
  // GPS UART2
  // ===================================================

  GPSserial.begin(
    9600,
    SERIAL_8N1,
    GPS_RX_PIN,
    GPS_TX_PIN
  );


  Serial.println(
    "NEO-6M GPS UART started"
  );


  // ===================================================
  // OLED
  // ===================================================

  if(
    !display.begin(
      SSD1306_SWITCHCAPVCC,
      0x3C
    )
  )
  {

    Serial.println(
      "OLED ERROR"
    );


    while(true)
    {
    }

  }


  display.clearDisplay();


  display.setTextColor(
    SSD1306_WHITE
  );


  display.setTextSize(
    1
  );


  display.setCursor(
    0,
    0
  );


  display.println(
    "HEALTH MONITOR"
  );


  display.println();


  display.println(
    "Starting..."
  );


  display.display();


  // ===================================================
  // KY-001
  // ===================================================

  tempSensor.begin();


  tempSensor.setResolution(
    10
  );


  tempSensor.setWaitForConversion(
    false
  );


  tempSensor.requestTemperatures();


  tempConversionStarted =
    true;


  lastTempRequest =
    millis();


  // ===================================================
  // MAX30102
  // ===================================================

  if(
    !particleSensor.begin(
      Wire,
      I2C_SPEED_FAST
    )
  )
  {

    Serial.println(
      "MAX30102 ERROR"
    );


    display.clearDisplay();


    display.setCursor(
      0,
      0
    );


    display.println(
      "MAX30102 ERROR"
    );


    display.display();


    while(true)
    {
    }

  }


  particleSensor.setup(
    30,
    4,
    2,
    100,
    411,
    8192
  );


  // ===================================================
  // ESP32 WIFI ACCESS POINT
  // ===================================================

  WiFi.mode(
    WIFI_AP
  );


  WiFi.softAP(
    apSSID,
    apPassword
  );


  IPAddress IP =
    WiFi.softAPIP();


  Serial.println();

  Serial.println(
    "================================"
  );


  Serial.println(
    "ESP32 HEALTH MONITOR"
  );


  Serial.println(
    "================================"
  );


  Serial.print(
    "WiFi Name : "
  );


  Serial.println(
    apSSID
  );


  Serial.print(
    "Password  : "
  );


  Serial.println(
    apPassword
  );


  Serial.print(
    "Dashboard : http://"
  );


  Serial.println(
    IP
  );


  Serial.println(
    "GPS RX GPIO16"
  );


  Serial.println(
    "GPS TX GPIO17"
  );


  Serial.println(
    "================================"
  );


  // ===================================================
  // WEB SERVER
  // ===================================================

  server.on(
    "/",
    handleRoot
  );


  server.on(
    "/data",
    handleData
  );


  server.begin();


  // ===================================================
  // STARTUP OLED
  // ===================================================

  display.clearDisplay();


  display.setCursor(
    0,
    0
  );


  display.println(
    "WiFi READY"
  );


  display.println();


  display.println(
    "ESP32-Health-Monitor"
  );


  display.println();


  display.println(
    "192.168.4.1"
  );


  display.println(
    "GPS starting..."
  );


  display.display();


  delay(
    2500
  );

}


// =====================================================
// LOOP
// =====================================================

void loop()
{

  // ===================================================
  // READ GPS CONTINUOUSLY
  // ===================================================

  while(
    GPSserial.available() >
    0
  )
  {

    char c =
      GPSserial.read();


    gps.encode(
      c
    );

  }


  // Current GPS fix only considered valid
  // if location data is recent.

  gpsFix =
    gps.location.isValid()
    &&
    gps.location.age() <
    5000;


  if(
    gpsFix
  )
  {

    gpsLatitude =
      gps.location.lat();


    gpsLongitude =
      gps.location.lng();

  }


  if(
    gps.satellites.isValid()
  )
  {

    gpsSatellites =
      gps.satellites.value();

  }


  if(
    gps.altitude.isValid()
  )
  {

    gpsAltitude =
      gps.altitude.meters();

  }


  if(
    gps.hdop.isValid()
  )
  {

    gpsHDOP =
      gps.hdop.hdop();

  }


  // GPS serial diagnostic once every 2 seconds

  if(
    millis() -
    lastGpsDebug >=
    2000
  )
  {

    lastGpsDebug =
      millis();


    Serial.print(
      "GPS Fix: "
    );


    Serial.print(
      gpsFix
      ?
      "YES"
      :
      "NO"
    );


    Serial.print(
      " | Satellites: "
    );


    Serial.print(
      gpsSatellites
    );


    if(
      gpsFix
    )
    {

      Serial.print(
        " | LAT: "
      );


      Serial.print(
        gpsLatitude,
        6
      );


      Serial.print(
        " | LON: "
      );


      Serial.print(
        gpsLongitude,
        6
      );


      Serial.print(
        " | ALT: "
      );


      Serial.print(
        gpsAltitude,
        1
      );


      Serial.print(
        " m"
      );

    }


    Serial.println();

  }


  // ===================================================
  // WEB SERVER
  // ===================================================

  server.handleClient();


  // ===================================================
  // MAX30102
  // ===================================================

  irValue =
    particleSensor.getIR();


  fingerDetected =
    irValue >
    20000;


  if(
    fingerDetected
  )
  {

    if(
      checkForBeat(
        irValue
      )
    )
    {

      unsigned long now =
        millis();


      if(
        lastBeat >
        0
      )
      {

        unsigned long delta =
          now -
          lastBeat;


        float newBPM =
          60000.0 /
          (float)delta;


        if(
          newBPM >= 25 &&
          newBPM <= 200
        )
        {

          currentBPM =
            newBPM;


          validBeatCount++;


          // =============================================
          // DISPLAY FILTER
          // =============================================

          if(
            displayBPM ==
            0
          )
          {

            displayBPM =
              newBPM;

          }
          else
          {

            displayBPM =
              (
                0.65 *
                displayBPM
              )
              +
              (
                0.35 *
                newBPM
              );

          }


          // =============================================
          // LOW HR ALERT
          // =============================================

          if(
            newBPM <
            HR_LOW_LIMIT
          )
          {

            if(
              lowBeatCount <
              255
            )
            {

              lowBeatCount++;

            }


            highBeatCount =
              0;


            normalBeatCount =
              0;


            if(
              lowBeatCount >=
              ABNORMAL_BEATS_REQUIRED
            )
            {

              lowHRAlert =
                true;


              highHRAlert =
                false;

            }

          }


          // =============================================
          // HIGH HR ALERT
          // =============================================

          else if(
            newBPM >
            HR_HIGH_LIMIT
          )
          {

            if(
              highBeatCount <
              255
            )
            {

              highBeatCount++;

            }


            lowBeatCount =
              0;


            normalBeatCount =
              0;


            if(
              highBeatCount >=
              ABNORMAL_BEATS_REQUIRED
            )
            {

              highHRAlert =
                true;


              lowHRAlert =
                false;

            }

          }


          // =============================================
          // NORMAL HR
          // =============================================

          else
          {

            lowBeatCount =
              0;


            highBeatCount =
              0;


            if(
              normalBeatCount <
              255
            )
            {

              normalBeatCount++;

            }


            if(
              normalBeatCount >=
              NORMAL_BEATS_TO_CLEAR
            )
            {

              lowHRAlert =
                false;


              highHRAlert =
                false;

            }

          }


          Serial.print(
            "HR Raw: "
          );


          Serial.print(
            currentBPM,
            1
          );


          Serial.print(
            " | Display: "
          );


          Serial.println(
            displayBPM,
            1
          );

        }

      }


      lastBeat =
        now;

    }

  }

  else
  {

    lastBeat =
      0;


    currentBPM =
      0;


    displayBPM =
      0;


    validBeatCount =
      0;


    lowBeatCount =
      0;


    highBeatCount =
      0;


    normalBeatCount =
      0;


    lowHRAlert =
      false;


    highHRAlert =
      false;

  }


  // ===================================================
  // KY-001 TEMPERATURE
  // ===================================================

  if(
    tempConversionStarted
  )
  {

    if(
      millis() -
      lastTempRequest >=
      200
    )
    {

      float newTemperature =
        tempSensor.getTempCByIndex(
          0
        );


      if(
        newTemperature !=
        DEVICE_DISCONNECTED_C
      )
      {

        temperatureC =
          newTemperature;


        temperatureValid =
          true;

      }
      else
      {

        temperatureValid =
          false;

      }


      tempConversionStarted =
        false;

    }

  }


  if(
    !tempConversionStarted
    &&
    millis() -
    lastTempRequest >=
    2000
  )
  {

    tempSensor.requestTemperatures();


    lastTempRequest =
      millis();


    tempConversionStarted =
      true;

  }


  // ===================================================
  // TEMPERATURE ALERT
  // ===================================================

  tempAlert =
    temperatureValid
    &&
    temperatureC >
    TEMP_HIGH_LIMIT;


  // ===================================================
  // OLED
  // ===================================================

  if(
    millis() -
    lastDisplayUpdate >=
    250
  )
  {

    lastDisplayUpdate =
      millis();


    display.clearDisplay();


    display.setTextColor(
      SSD1306_WHITE
    );


    // =================================================
    // ALERT DISPLAY
    // =================================================

    if(
      tempAlert ||
      lowHRAlert ||
      highHRAlert
    )
    {

      display.setTextSize(
        2
      );


      display.setCursor(
        29,
        0
      );


      display.println(
        "ALERT"
      );


      display.setTextSize(
        1
      );


      if(
        lowHRAlert
      )
      {

        display.setCursor(
          0,
          22
        );


        display.println(
          "LOW HEART RATE"
        );

      }


      if(
        highHRAlert
      )
      {

        display.setCursor(
          0,
          22
        );


        display.println(
          "HIGH HEART RATE"
        );

      }


      if(
        tempAlert
      )
      {

        display.setCursor(
          0,
          34
        );


        display.print(
          "HIGH TEMP: "
        );


        display.print(
          temperatureC,
          1
        );


        display.print(
          " C"
        );

      }


      display.setCursor(
        0,
        51
      );


      display.print(
        "HR:"
      );


      display.print(
        currentBPM,
        0
      );


      display.print(
        " GPS:"
      );


      display.print(
        gpsFix
        ?
        "FIX"
        :
        "NO"
      );

    }


    // =================================================
    // NORMAL DISPLAY
    // =================================================

    else
    {

      display.setTextSize(
        1
      );


      display.setCursor(
        17,
        0
      );


      display.println(
        "HEALTH MONITOR"
      );


      display.drawLine(
        0,
        11,
        127,
        11,
        SSD1306_WHITE
      );


      display.setCursor(
        0,
        17
      );


      display.print(
        "Heart Rate:"
      );


      if(
        !fingerDetected
      )
      {

        display.setCursor(
          20,
          29
        );


        display.print(
          "PLACE FINGER"
        );

      }

      else if(
        validBeatCount <
        2
      )
      {

        display.setCursor(
          20,
          29
        );


        display.print(
          "MEASURING..."
        );

      }

      else
      {

        display.setTextSize(
          2
        );


        display.setCursor(
          20,
          25
        );


        display.print(
          displayBPM,
          0
        );


        display.setTextSize(
          1
        );


        display.print(
          " BPM"
        );

      }


      display.setTextSize(
        1
      );


      display.setCursor(
        0,
        46
      );


      display.print(
        "Temp:"
      );


      if(
        temperatureValid
      )
      {

        display.print(
          temperatureC,
          1
        );


        display.print(
          "C"
        );

      }
      else
      {

        display.print(
          "--"
        );

      }


      display.setCursor(
        78,
        46
      );


      display.print(
        "GPS:"
      );


      display.print(
        gpsFix
        ?
        "FIX"
        :
        "NO"
      );


      display.setCursor(
        0,
        56
      );


      display.print(
        "Sat:"
      );


      display.print(
        gpsSatellites
      );

    }


    display.display();

  }

}